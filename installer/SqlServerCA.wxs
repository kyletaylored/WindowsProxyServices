<?xml version="1.0" encoding="UTF-8"?>
<!--
  SqlServerCA.wxs — SQL Server Express install + permission setup custom actions.

  Two custom actions run in sequence during every install:

  1. InstallSqlExpressCA   (condition: SQLEXPRESS absent AND NOT REMOVE)
     Runs scripts\Install-SqlExpress.ps1 to download and install SQL Server
     Express silently.  Skipped only when a SQLEXPRESS named instance is already
     registered — a different SQL Server instance (e.g. MSSQLSERVER) does NOT
     satisfy this check, because we cannot rely on having sysadmin rights on an
     existing corporate instance.

  2. GrantSqlSystemAccessCA   (condition: NOT REMOVE)
     Runs scripts\Grant-SqlSystemAccess.ps1 on every install — whether SQL
     Express was pre-existing or was just installed above — to give
     NT AUTHORITY\SYSTEM sysadmin on the SQLEXPRESS instance.

  Both are Return="ignore" — failure is non-fatal.  WindowsSqlService retries
  the connection at every startup via DbSetup.InitializeAsync, so the service
  recovers automatically once access is in place.  Both scripts log to
  C:\Windows\Temp\wps-install.log.

  The PowerShell lives in .ps1 files installed with the product rather than
  inline in ExeCommand: ExeCommand is an MSI Formatted string, where [...] is a
  property reference and {...} groups containing an unresolved one are deleted,
  which silently mangles inline PowerShell ([IO.Path], [DateTime], …).

  This fragment is pulled into the MSI by the SqlScriptComponents
  ComponentGroupRef in Product.wxs.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>

    <!-- ── Scripts installed alongside the services ───────────────────── -->
    <ComponentGroup Id="SqlScriptComponents" Directory="INSTALLFOLDER">
      <Component Id="CompSqlInstallScript">
        <File Id="FileSqlInstallPs1"
              Source="$(sys.SOURCEFILEDIR)scripts\Install-SqlExpress.ps1"
              KeyPath="yes" />
      </Component>
      <Component Id="CompSqlGrantScript">
        <File Id="FileSqlGrantPs1"
              Source="$(sys.SOURCEFILEDIR)scripts\Grant-SqlSystemAccess.ps1"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- ── Detect an existing SQLEXPRESS instance ──────────────────────── -->
    <!--
      Only checks for SQLEXPRESS specifically.  A different SQL Server instance
      (MSSQLSERVER, named instance) does not satisfy this — we install our own
      Express instance so we control the service account and sysadmin grants.
    -->
    <Property Id="SQLEXPRESS_INSTALLED">
      <RegistrySearch Id="SqlExpressSearch"
        Root="HKLM"
        Key="SOFTWARE\Microsoft\Microsoft SQL Server\Instance Names\SQL"
        Name="SQLEXPRESS"
        Type="raw" />
    </Property>

    <!--
      64-bit Windows PowerShell (System64Folder, not SystemFolder → SysWOW64),
      so the scripts' HKLM:\SOFTWARE registry reads are not redirected to
      WOW6432Node.
    -->
    <SetProperty Id="WPS_POWERSHELL"
      Value="[System64Folder]WindowsPowerShell\v1.0\powershell.exe"
      Sequence="execute"
      Before="InstallSqlExpressCA" />


    <!-- ══════════════════════════════════════════════════════════════════
         1. INSTALL SQL EXPRESS (skipped only when SQLEXPRESS already present)
         Runs as SYSTEM (Impersonate="no") — SQL setup requires elevation.
    ══════════════════════════════════════════════════════════════════ -->
    <CustomAction Id="InstallSqlExpressCA"
      Property="WPS_POWERSHELL"
      ExeCommand="-NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#FileSqlInstallPs1]&quot;"
      Execute="deferred"
      Impersonate="no"
      Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="InstallSqlExpressCA"
        After="InstallFiles"
        Condition="NOT SQLEXPRESS_INSTALLED AND NOT REMOVE" />
    </InstallExecuteSequence>


    <!-- ══════════════════════════════════════════════════════════════════
         2. GRANT NT AUTHORITY\SYSTEM SYSADMIN (always runs on install)
         Runs as the installing user (Impersonate="yes") so it connects with
         the elevated admin token, which is sysadmin via BUILTIN\Administrators.
    ══════════════════════════════════════════════════════════════════ -->
    <CustomAction Id="GrantSqlSystemAccessCA"
      Property="WPS_POWERSHELL"
      ExeCommand="-NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[#FileSqlGrantPs1]&quot;"
      Execute="deferred"
      Impersonate="yes"
      Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="GrantSqlSystemAccessCA"
        After="InstallSqlExpressCA"
        Condition="NOT REMOVE" />
    </InstallExecuteSequence>

    <!--
      ActionText table entries — displayed in the progress dialog's status area
      while each custom action runs.  Without these the progress bar shows the raw
      action ID ("InstallSqlExpressCA") or nothing at all.
    -->
    <UI>
      <ProgressText Action="InstallSqlExpressCA" Message="Downloading and installing SQL Server Express — this may take several minutes…" />
      <ProgressText Action="GrantSqlSystemAccessCA" Message="Configuring SQL Server access for Windows services…" />
    </UI>

  </Fragment>

</Wix>
